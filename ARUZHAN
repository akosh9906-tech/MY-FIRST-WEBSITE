require('dotenv').config();
const express = require('express');
const multer = require('multer');
const fs = require('fs');
const path = require('path');
const crypto = require('crypto');

const PORT = process.env.PORT || 3000;
const MODEL = process.env.MODEL || 'claude-sonnet-5-5';
const KEY = process.env.ANTHROPIC_API_KEY;
const DATA = path.join(__dirname, 'data');
const UPLOADS = path.join(__dirname, 'uploads');
[DATA, UPLOADS].forEach(d => fs.mkdirSync(d, { recursive: true }));

const SYSTEM = `Ты — ZANAI, ИИ-помощник, который объясняет законы Республики Казахстан простым языком.
Цель: чтобы человек знал свои права и не терял деньги, время и не сталкивался с несправедливостью.

Как работать:
1. Внимательно выслушай проблему. Если не хватает важных фактов (даты, суммы, кто стороны, есть ли договор) — задай 1–3 уточняющих вопроса.
2. ВСЕГДА ищи актуальные нормы на сайте adilet.kz (инструмент поиска) и опирайся на них. Называй закон/кодекс, номер статьи и давай ссылку. Не выдумывай статьи: если не нашёл — так и скажи.
3. Объясняй по этапам: «Что происходит по закону» → «Ваши права» → «Что делать пошагово» (какие документы собрать, куда обратиться: работодатель, трудовая инспекция, суд, прокуратура, акимат, ЦОН, egov.kz и т.д.) → «Сроки».
4. Если пользователь прислал документ или фото (договор, приказ, уведомление) — разбери его: суть, риски, спорные пункты, что не соответствует закону, что стоит изменить.
5. Темы: трудоустройство, жильё и аренда, договоры, потребительские права, семья, долги и кредиты, штрафы, налоги, наследство и др.
6. Пиши простым языком, без лишнего юридического жаргона, коротко и структурно. Отвечай на языке пользователя (русский или казахский).
7. В конце напоминай при серьёзных делах (суд, крупные суммы), что ты даёшь справочную информацию, а не заменяешь адвоката.`;

const app = express();
app.use(express.json({ limit: '1mb' }));
app.use(express.static(path.join(__dirname, 'public')));

const upload = multer({
  storage: multer.diskStorage({
    destination: (req, file, cb) => cb(null, UPLOADS),
    filename: (req, file, cb) =>
      cb(null, crypto.randomUUID() + path.extname(file.originalname).toLowerCase())
  }),
  limits: { fileSize: 15 * 1024 * 1024, files: 5 }
});

// ---------- хранилище (JSON-файл на пользователя) ----------
const safeId = s => String(s || '').replace(/[^a-zA-Z0-9-]/g, '').slice(0, 64);
const userFile = uid => path.join(DATA, safeId(uid) + '.json');
const load = uid => {
  try { return JSON.parse(fs.readFileSync(userFile(uid), 'utf8')); }
  catch { return { chats: [] }; }
};
const save = (uid, db) => fs.writeFileSync(userFile(uid), JSON.stringify(db, null, 2));
const uidOf = req => {
  const id = safeId(req.get('x-user-id'));
  return id.length >= 16 ? id : null;
};

// ---------- API ----------
app.get('/api/chats', (req, res) => {
  const uid = uidOf(req); if (!uid) return res.status(401).end();
  res.json(load(uid).chats.map(({ id, title, updated }) => ({ id, title, updated }))
    .sort((a, b) => b.updated - a.updated));
});

app.get('/api/chats/:id', (req, res) => {
  const uid = uidOf(req); if (!uid) return res.status(401).end();
  const chat = load(uid).chats.find(c => c.id === req.params.id);
  chat ? res.json(chat) : res.status(404).end();
});

app.delete('/api/chats/:id', (req, res) => {
  const uid = uidOf(req); if (!uid) return res.status(401).end();
  const db = load(uid);
  db.chats = db.chats.filter(c => c.id !== req.params.id);
  save(uid, db);
  res.json({ ok: true });
});

app.get('/files/:name', (req, res) => {
  const uid = uidOf(req) || safeId(req.query.uid);
  const name = path.basename(req.params.name);
  const db = load(uid);
  const owns = db.chats.some(c => c.messages.some(m => (m.files || []).some(f => f.stored === name)));
  if (!owns) return res.status(403).end();
  res.sendFile(path.join(UPLOADS, name));
});

const MEDIA = { '.jpg': 'image/jpeg', '.jpeg': 'image/jpeg', '.png': 'image/png', '.webp': 'image/webp', '.gif': 'image/gif' };

function fileToBlock(f) {
  const ext = path.extname(f.stored).toLowerCase();
  const buf = fs.readFileSync(path.join(UPLOADS, f.stored));
  if (MEDIA[ext]) return { type: 'image', source: { type: 'base64', media_type: MEDIA[ext], data: buf.toString('base64') } };
  if (ext === '.pdf') return { type: 'document', source: { type: 'base64', media_type: 'application/pdf', data: buf.toString('base64') } };
  return { type: 'text', text: `Содержимое файла «${f.name}»:\n${buf.toString('utf8').slice(0, 60000)}` };
}

async function askClaude(messages) {
  let msgs = messages;
  for (let i = 0; i < 4; i++) {
    const r = await fetch('https://api.anthropic.com/v1/messages', {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'x-api-key': KEY, 'anthropic-version': '2023-06-01' },
      body: JSON.stringify({
        model: MODEL,
        max_tokens: 4000,
        system: SYSTEM,
        messages: msgs,
        tools: [{ type: 'web_search_20250305', name: 'web_search', max_uses: 5, allowed_domains: ['adilet.kz'] }]
      })
    });
    const data = await r.json();
    if (!r.ok) throw new Error(data.error?.message || 'Ошибка API');
    if (data.stop_reason === 'pause_turn') {
      msgs = [...msgs, { role: 'assistant', content: data.content }];
      continue;
    }
    const sources = new Map();
    let text = '';
    for (const b of data.content) {
      if (b.type !== 'text') continue;
      text += b.text;
      (b.citations || []).forEach(c => c.url && sources.set(c.url, c.title || c.url));
    }
    return { text: text.trim(), sources: [...sources].map(([url, title]) => ({ url, title })) };
  }
  throw new Error('Поиск занял слишком много времени, попробуйте ещё раз');
}

app.post('/api/chat', upload.array('files', 5), async (req, res) => {
  try {
    const uid = uidOf(req); if (!uid) return res.status(401).json({ error: 'Нет идентификатора' });
    if (!KEY) return res.status(500).json({ error: 'Не задан ANTHROPIC_API_KEY в файле .env' });
    const text = (req.body.message || '').trim();
    const files = (req.files || []).map(f => ({ name: Buffer.from(f.originalname, 'latin1').toString('utf8'), stored: f.filename }));
    if (!text && !files.length) return res.status(400).json({ error: 'Пустое сообщение' });

    const db = load(uid);
    let chat = db.chats.find(c => c.id === req.body.chatId);
    if (!chat) {
      chat = { id: crypto.randomUUID(), title: (text || files[0].name).slice(0, 50), updated: Date.now(), messages: [] };
      db.chats.push(chat);
    }
    chat.messages.push({ role: 'user', content: text, files, time: Date.now() });

    const history = chat.messages.slice(0, -1).slice(-20).map(m => ({
      role: m.role,
      content: m.content + ((m.files || []).length ? `\n[Прикреплено: ${m.files.map(f => f.name).join(', ')}]` : '')
    })).filter(m => m.content);
    const current = [...files.map(fileToBlock),
      { type: 'text', text: text || 'Проанализируй приложенный документ: объясни суть, риски и что делать.' }];
    const msgs = [...history, { role: 'user', content: current }];

    const answer = await askClaude(msgs);
    chat.messages.push({ role: 'assistant', content: answer.text, sources: answer.sources, time: Date.now() });
    chat.updated = Date.now();
    save(uid, db);
    res.json({ chatId: chat.id, title: chat.title, user: { files }, answer });
  } catch (e) {
    console.error(e);
    res.status(500).json({ error: e.message });
  }
});

app.listen(PORT, () => console.log(`ZANAI запущен: http://localhost:${PORT}`));
