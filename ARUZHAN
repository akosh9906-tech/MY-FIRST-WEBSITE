body{margin:0;display:flex;height:100vh;height:100dvh;font:16px/1.55 Onest,system-ui,sans-serif;background:var(--bg);color:var(--ink)}
button{font:inherit;cursor:pointer}
:focus-visible{outline:3px solid var(--sun);outline-offset:2px}
