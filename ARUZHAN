#chatList .del{flex:0;opacity:.6}
.note{font-size:12px;color:#93a6b6;margin:0}
main{flex:1;display:flex;flex-direction:column;min-width:0}
header{display:flex;align-items:center;gap:10px;padding:12px 20px;border-bottom:1px solid var(--line);background:var(--card)}
